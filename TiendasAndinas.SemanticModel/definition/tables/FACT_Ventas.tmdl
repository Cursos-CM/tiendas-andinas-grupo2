	partition FACT_Ventas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "FACT_Ventas.csv"),[Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    ColumnasQuitadas = Table.RemoveColumns(Encabezados, {"ETL_LoadDate", "Columna1"}),
				    Tipos = Table.TransformColumnTypes(ColumnasQuitadas, {{"NumOrden", Int64.Type}, {"LineaOrden", Int64.Type}, {"FechaOrden", type date}, {"FechaEnvio", type date}, {"cust_id", Int64.Type}, {"ProductoKey", Int64.Type}, {"TiendaKey", Int64.Type}, {"Canal", type text}, {"Cantidad", Int64.Type}, {"precio unit", type number}, {"Descuento_Pct", type number}, {"CostoUnitario", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

