table FACT_Ventas
	lineageTag: f49893e2-f93c-56e3-a7e6-705447df7feb

	measure 'Total Ventas' = SUMX(FACT_Ventas, FACT_Ventas[Cantidad] * FACT_Ventas[precio unit] * (1 - FACT_Ventas[Descuento_Pct]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Ventas
		lineageTag: 8abd3a7c-24a9-518e-bc9f-4403b6a71565

	measure 'Unidades Vendidas' = SUM(FACT_Ventas[Cantidad])
		formatString: #,0
		displayFolder: Ventas
		lineageTag: 63afbd0b-32ed-518f-91ca-f8f59bdac0ad

	measure '# Órdenes' = DISTINCTCOUNT(FACT_Ventas[NumOrden])
		formatString: #,0
		displayFolder: Ventas
		lineageTag: 3ca814c0-372d-5dea-bfb6-935c2bab94c7

	measure '# Clientes' = DISTINCTCOUNT(FACT_Ventas[cust_id])
		formatString: #,0
		displayFolder: Ventas
		lineageTag: ffd45c83-26cd-5062-9ad5-4af3952aa1b4

	measure 'Ticket Promedio' = DIVIDE([Total Ventas], [# Órdenes])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Ventas
		lineageTag: e9f0ca74-775d-5aed-8868-3aa17186267b

	measure 'Ventas Online' = CALCULATE([Total Ventas], KEEPFILTERS(FACT_Ventas[Canal] = "Online"))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Ventas
		lineageTag: 35763ba7-360e-55e7-9ecb-b8a42ff559de

	measure Costo = SUMX(FACT_Ventas, FACT_Ventas[Cantidad] * FACT_Ventas[CostoUnitario])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Rentabilidad
		lineageTag: f18ce31a-9b0a-5758-86b7-c280590e528a

	measure margen = [Total Ventas] - [Costo]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Rentabilidad
		lineageTag: e5dee703-6a09-5d81-abd6-fb18c2a3aa31

	measure 'Margen %' = DIVIDE([margen], [Total Ventas])
		formatString: 0.0%
		displayFolder: Rentabilidad
		lineageTag: 1750ce73-c8a5-5331-9ca9-99f5d43efd22

	measure 'Ventas YTD' = TOTALYTD([Total Ventas], Calendario[Fecha])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Inteligencia de tiempo
		lineageTag: 2e4f59e0-5958-51e9-b875-8e0236f871b2

	measure 'Ventas AA' = CALCULATE([Total Ventas], SAMEPERIODLASTYEAR(Calendario[Fecha]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Inteligencia de tiempo
		lineageTag: 8d6bc51e-d603-5daa-8089-0233d6954c2e

	measure 'Crecimiento AA %' = DIVIDE([Total Ventas] - [Ventas AA], [Ventas AA])
		formatString: 0.0%
		displayFolder: Inteligencia de tiempo
		lineageTag: 25e0ccef-c9cc-5d21-9dc2-e1552b0283cd

	measure 'Ventas por Fecha de Envío' = CALCULATE([Total Ventas], USERELATIONSHIP(FACT_Ventas[FechaEnvio], Calendario[Fecha]))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Ventas
		lineageTag: 98912dcc-5e7c-55f6-816e-71fe13212baf

	measure 'Unidades Devueltas' = SUM(fact_devoluciones[CantidadDevuelta])
		formatString: #,0
		displayFolder: Devoluciones
		lineageTag: 11722315-fc31-533d-be4e-d188d1e85de8

	measure 'Tasa Devolucion' = DIVIDE([Unidades Devueltas], [Unidades Vendidas])
		formatString: 0.0%
		displayFolder: Devoluciones
		lineageTag: 595f5269-78ed-5b68-bf77-0aa8d46e6445

	measure Presupuesto = SUM(Presupuesto[ValorPresupuesto])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Presupuesto
		lineageTag: 26a47151-06dd-526c-9f25-d6d732199cf7

	measure Cumplimiento = DIVIDE([Total Ventas], [Presupuesto])
		formatString: 0.0%
		displayFolder: Presupuesto
		lineageTag: 68182326-8efc-5bc1-b4bb-516e0e57392b

	measure 'Diferencia vs Presupuesto' = [Total Ventas] - [Presupuesto]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Presupuesto
		lineageTag: 044f5df0-8af8-52f5-8498-a37cdef53152

