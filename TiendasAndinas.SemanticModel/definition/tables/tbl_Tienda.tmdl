	partition tbl_Tienda = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "tbl_Tienda.csv"),[Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"TiendaKey", Int64.Type}, {"Tienda", type text}, {"Ciudad", type text}, {"Departamento", type text}, {"Region", type text}, {"Tipo", type text}, {"FechaApertura", type date}, {"MetrosCuadrados", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

